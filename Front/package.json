{
  "name": "riesgo-credito-front",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Front estático y autónomo del Proyecto Integrador: simula con fidelidad la corrida real del back (ADR-004).",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
